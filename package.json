{
    "name": "joplin-plugin-codeblock-autocomplete",
    "version": "1.7.0",
    "scripts": {
        "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
        "prepare": "npm run dist",
        "updateVersion": "webpack --env joplin-plugin-config=updateVersion",
        "update": "npm install -g generator-joplin && yo joplin --node-package-manager npm --update --force",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write \"src/**/*.{ts,js,css}\"",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "knip": "knip"
    },
    "license": "MIT",
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@codemirror/autocomplete": "6.20.1",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.12.3",
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.14",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@lezer/common": "1.5.0",
        "@types/node": "^24.13.2",
        "@vitest/eslint-plugin": "^1.6.28",
        "chalk": "^4.1.0",
        "copy-webpack-plugin": "^14.0.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "fs-extra": "^10.1.0",
        "glob": "^14.0.4",
        "globals": "^17.7.0",
        "jsdom": "^31.0.0",
        "knip": "^6.44.1",
        "prettier": "^3.6.2",
        "tar": "^7.5.12",
        "ts-loader": "^9.3.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0",
        "webpack": "^5.105.4",
        "webpack-cli": "^6.0.1"
    },
    "overrides": {
        "eslint-plugin-tsdoc": {
            "@typescript-eslint/utils": "8.72.1"
        }
    }
}
